[sub_resource type="GDScript" id="GDScript_bu3ac"]
script/source = "extends Node3D

func _ready():
	var pos = Vector3(-15, 0, -10)
	for i in range(5):
		var bot = BotBuilder.get_bot()
		add_child(bot)
		bot.WanderSpeed = 0
		bot.ChaseSpeed = 0
		bot.AttackCooldown = 1000
		bot.TurnSpeed = 0
		bot.global_position = pos
		pos += Vector3(4, 0, 0)
		
"

